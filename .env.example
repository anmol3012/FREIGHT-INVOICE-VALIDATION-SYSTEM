# ==============================================================================
# Freight Invoice Validation System — Environment Configuration Template
# Copy this file to .env and adjust variables as required for your environment.
# Never commit real credentials, passwords, or production API keys to git.
# ==============================================================================

# Application Environment (development, testing, production)
ENVIRONMENT=development
APP_NAME="Freight Invoice Validation System"
APP_VERSION=1.0.0
DEBUG=True

# Database Configuration
# Local SQLite Default (WAL mode enabled automatically)
DATABASE_URL=sqlite:///data/freight_validation.db

# Production PostgreSQL Example:
# DATABASE_URL=postgresql+psycopg2://freight_user:change_me@localhost:5432/freight_db

# API & Server Configuration
API_V1_PREFIX=/api/v1
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173"]

# Synthetic Data Generator Defaults
DEFAULT_RANDOM_SEED=20261022
DEFAULT_PROFILE=starter
EXPORT_DIR=data/exports

# Freight Audit Engine Tolerances
ABSOLUTE_TOLERANCE_USD=0.50
PERCENTAGE_TOLERANCE=0.005
METRIC_DIMENSIONAL_DIVISOR=5000.0

# Operations Security & Passwords
# In production, set strong, cryptographically generated secrets
SECRET_KEY=dev-insecure-secret-key-change-in-production-32chars-min
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
