{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start Server (FastAPI + Dashboard)",
      "type": "shell",
      "command": ".\\.venv\\Scripts\\python.exe",
      "args": [
        "-m",
        "backend.app.cli",
        "serve",
        "--host",
        "127.0.0.1",
        "--port",
        "8000"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "Seed Starter Dataset",
      "type": "shell",
      "command": ".\\.venv\\Scripts\\python.exe",
      "args": [
        "-m",
        "backend.app.cli",
        "seed",
        "--scale",
        "starter",
        "--reset"
      ],
      "problemMatcher": []
    },
    {
      "label": "Run Validation Audit",
      "type": "shell",
      "command": ".\\.venv\\Scripts\\python.exe",
      "args": [
        "-m",
        "backend.app.cli",
        "validate",
        "--all"
      ],
      "problemMatcher": []
    },
    {
      "label": "Run Pytest Suite",
      "type": "shell",
      "command": ".\\.venv\\Scripts\\pytest.exe",
      "args": [
        "-v"
      ],
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Frontend: Start Dev Server (Vite)",
      "type": "shell",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "problemMatcher": []
    },
    {
      "label": "Frontend: Build Production Bundle",
      "type": "shell",
      "command": "npm run build",
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "problemMatcher": []
    }
  ]
}
